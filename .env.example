# =====================================================================
#  CONFIGURAZIONE DEL SITO
# =====================================================================
#  In locale: copia questo file in ".env.local" e compila i valori.
#  Online: imposta le stesse variabili nel pannello del tuo hosting
#  (es. Vercel > Settings > Environment Variables) e ripubblica.
#  NON committare mai file con credenziali reali (.env.local e' ignorato da git).
#
#  Dopo ogni modifica verifica con:   npm run test:email
# =====================================================================

# --- Recapiti mostrati sul sito (NON segreti) -------------------------
# Email pubblica e destinataria delle richieste dei clienti
NEXT_PUBLIC_CONTACT_EMAIL=nicoletadiana875@gmail.com
# Telefono in formato internazionale, con "+"
NEXT_PUBLIC_CONTACT_PHONE=+393890909665
# Numero WhatsApp, senza "+"
NEXT_PUBLIC_WHATSAPP_NUMBER=393890909665
# Indirizzo pubblico del sito (serve ai collegamenti nelle email di conferma)
NEXT_PUBLIC_SITE_URL=https://www.tuodominio.it

# --- Invio email del modulo contatti (SEGRETI) ------------------------
# Server di posta e account che spedisce.
# Gmail: attiva la verifica in due passaggi e crea una "password per le app" su
# https://myaccount.google.com/apppasswords  (non usare la password normale).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nicoletadiana875@gmail.com
SMTP_PASS=
# Con la porta 587 la connessione parte in chiaro e passa a TLS: imposta SMTP_SECURE=false

# --- Destinatario e mittente (opzionali) ------------------------------
# Chi riceve le richieste. Se omesso: NEXT_PUBLIC_CONTACT_EMAIL.
# CONTACT_TO=
# Mittente mostrato nelle email. Se omesso: SMTP_USER.
# Con Gmail il mittente coincide con l'account (o con un alias verificato nel suo pannello).
# CONTACT_FROM=
# Email di conferma di ricezione al cliente (predefinito: attiva)
# CONTACT_CONFIRMATION=true

# --- Stoccaggi gas Italia (opzionale, gratuito) -------------------------
# Registrazione gratuita su https://agsi.gie.eu/account (si ottiene subito la chiave API).
# Condizione d'uso: citare GIE/AGSI come fonte (il sito lo fa in automatico).
AGSI_API_KEY=

# --- Dati di mercato ufficiali GME (opzionale, NON attivare senza licenza) ---
# ATTENZIONE: la licenza standard dell'API GME ammette solo un uso informativo e privato
# e VIETA usi economici/commerciali. Mostrare questi dati sul sito di un'attivita' di
# consulenza richiede il consenso scritto di GME (info@mercatoelettrico.org).
# L'integrazione resta spenta finche' non sono presenti TUTTE e tre le variabili.
# Senza GME l'elettricita' arriva da Energy-Charts (zona Nord, CC BY 4.0) e il gas
# risulta "non disponibile": nessun valore viene mai stimato.
GME_API_USER=
GME_API_PASSWORD=
# Impostare "confirmed" solo dopo aver ottenuto la licenza commerciale scritta di GME
GME_COMMERCIAL_LICENSE=
